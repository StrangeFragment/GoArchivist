index 82be054..4a3defa 100644
--- a/internal/storage/database.go
+++ b/internal/storage/database.go
@@ -1 +1,60 @@
 package storage
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	_ "modernc.org/sqlite"
+)
+
+// Open returns a configured SQLite database and creates the initial schema.
+// The pure-Go modernc driver keeps Windows builds independent of CGO.
+func Open(path string) (*sql.DB, error) {
+	if path == "" {
+		return nil, errors.New("путь к базе данных не задан")
+	}
+	if path != ":memory:" {
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			return nil, fmt.Errorf("не удалось создать папку базы данных: %w", err)
+		}
+	}
+
+	db, err := sql.Open("sqlite", path)
+	if err != nil {
+		return nil, fmt.Errorf("не удалось открыть SQLite: %w", err)
+	}
+	db.SetMaxOpenConns(1)
+	db.SetMaxIdleConns(1)
+
+	if err := db.Ping(); err != nil {
+		_ = db.Close()
+		return nil, fmt.Errorf("не удалось подключиться к SQLite: %w", err)
+	}
+
+	if _, err := db.Exec(`
+		PRAGMA foreign_keys = ON;
+		PRAGMA busy_timeout = 5000;
+		CREATE TABLE IF NOT EXISTS mailboxes (
+			id INTEGER PRIMARY KEY,
+			imap_name TEXT NOT NULL UNIQUE,
+			display_name TEXT NOT NULL,
+			is_watched INTEGER NOT NULL DEFAULT 0 CHECK (is_watched IN (0, 1)),
+			is_available INTEGER NOT NULL DEFAULT 1 CHECK (is_available IN (0, 1)),
+			discovered_at TEXT NOT NULL,
+			last_seen_at TEXT NOT NULL,
+			uid_validity INTEGER,
+			last_uid INTEGER,
+			last_synced_at TEXT
+		);
+		CREATE INDEX IF NOT EXISTS idx_mailboxes_watched_available
+			ON mailboxes(is_watched, is_available);
+	`); err != nil {
+		_ = db.Close()
+		return nil, fmt.Errorf("не удалось создать схему SQLite: %w", err)
+	}
+
+	return db, nil
+}
diff --git a/internal/storage/mailbox.go b/internal/storage/mailbox.go
index 82be054..b21fcd6 100644
--- a/internal/storage/mailbox.go
+++ b/internal/storage/mailbox.go
@@ -1 +1,156 @@
 package storage
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"GoArchivist/internal/mail"
+)
+
+// Mailbox stores both the server's protocol name and a human-readable label.
+// Name must remain unchanged for future IMAP commands.
+type Mailbox struct {
+	Name        string
+	DisplayName string
+	Watched     bool
+	Available   bool
+}
+
+// RefreshMailboxes refreshes the discovered mailbox catalog. Existing watch
+// choices and future sync checkpoints are preserved; new folders start off,
+// except INBOX, which is selected by default.
+func RefreshMailboxes(ctx context.Context, db *sql.DB, names []string) error {
+	if db == nil {
+		return errors.New("база данных не открыта")
+	}
+
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		return fmt.Errorf("не удалось начать обновление списка папок: %w", err)
+	}
+	defer tx.Rollback()
+
+	if _, err := tx.ExecContext(ctx, `UPDATE mailboxes SET is_available = 0`); err != nil {
+		return fmt.Errorf("не удалось отметить старые папки: %w", err)
+	}
+
+	now := time.Now().UTC().Format(time.RFC3339Nano)
+	for _, name := range names {
+		if name == "" {
+			continue
+		}
+		defaultWatched := 0
+		if strings.EqualFold(name, "INBOX") {
+			defaultWatched = 1
+		}
+		_, err := tx.ExecContext(ctx, `
+			INSERT INTO mailboxes (
+				imap_name, display_name, is_watched, is_available, discovered_at, last_seen_at
+			) VALUES (?, ?, ?, 1, ?, ?)
+			ON CONFLICT(imap_name) DO UPDATE SET
+				display_name = excluded.display_name,
+				is_available = 1,
+				last_seen_at = excluded.last_seen_at
+		`, name, mail.DisplayMailboxName(name), defaultWatched, now, now)
+		if err != nil {
+			return fmt.Errorf("не удалось сохранить папку IMAP %q: %w", name, err)
+		}
+	}
+
+	if err := tx.Commit(); err != nil {
+		return fmt.Errorf("не удалось завершить обновление папок: %w", err)
+	}
+	return nil
+}
+
+// ListMailboxes returns currently available folders, with INBOX first.
+func ListMailboxes(ctx context.Context, db *sql.DB) ([]Mailbox, error) {
+	if db == nil {
+		return nil, errors.New("база данных не открыта")
+	}
+	rows, err := db.QueryContext(ctx, `
+		SELECT imap_name, display_name, is_watched, is_available
+		FROM mailboxes
+		WHERE is_available = 1
+		ORDER BY CASE WHEN upper(imap_name) = 'INBOX' THEN 0 ELSE 1 END,
+		         display_name COLLATE NOCASE,
+		         imap_name
+	`)
+	if err != nil {
+		return nil, fmt.Errorf("не удалось загрузить список папок: %w", err)
+	}
+	defer rows.Close()
+
+	var mailboxes []Mailbox
+	for rows.Next() {
+		var mailbox Mailbox
+		var watched, available int
+		if err := rows.Scan(&mailbox.Name, &mailbox.DisplayName, &watched, &available); err != nil {
+			return nil, fmt.Errorf("не удалось прочитать папку из базы данных: %w", err)
+		}
+		mailbox.Watched = watched != 0
+		mailbox.Available = available != 0
+		mailboxes = append(mailboxes, mailbox)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("ошибка чтения списка папок: %w", err)
+	}
+	return mailboxes, nil
+}
+
+// SaveWatchedMailboxes atomically stores the user's selection. Names not in
+// the currently discovered catalog are rejected instead of silently saved.
+func SaveWatchedMailboxes(ctx context.Context, db *sql.DB, names []string) error {
+	if db == nil {
+		return errors.New("база данных не открыта")
+	}
+
+	unique := make(map[string]struct{}, len(names))
+	for _, name := range names {
+		if name == "" {
+			return errors.New("получено пустое имя папки")
+		}
+		unique[name] = struct{}{}
+	}
+
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		return fmt.Errorf("не удалось начать сохранение выбора папок: %w", err)
+	}
+	defer tx.Rollback()
+
+	for name := range unique {
+		var available int
+		if err := tx.QueryRowContext(ctx,
+			`SELECT is_available FROM mailboxes WHERE imap_name = ?`, name,
+		).Scan(&available); err != nil {
+			if errors.Is(err, sql.ErrNoRows) {
+				return fmt.Errorf("неизвестная папка IMAP: %q", name)
+			}
+			return fmt.Errorf("не удалось проверить папку %q: %w", name, err)
+		}
+		if available == 0 {
+			return fmt.Errorf("папка %q больше не доступна на сервере", name)
+		}
+	}
+
+	if _, err := tx.ExecContext(ctx, `UPDATE mailboxes SET is_watched = 0 WHERE is_available = 1`); err != nil {
+		return fmt.Errorf("не удалось сбросить выбор папок: %w", err)
+	}
+	for name := range unique {
+		if _, err := tx.ExecContext(ctx,
+			`UPDATE mailboxes SET is_watched = 1 WHERE imap_name = ? AND is_available = 1`, name,
+		); err != nil {
+			return fmt.Errorf("не удалось включить отслеживание папки %q: %w", name, err)
+		}
+	}
+
+	if err := tx.Commit(); err != nil {
+		return fmt.Errorf("не удалось сохранить выбор папок: %w", err)
+	}
+	return nil
+}
