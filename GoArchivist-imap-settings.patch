diff --git a/internal/mail/modified_utf7.go b/internal/mail/modified_utf7.go
new file mode 100644
index 0000000..c108970
--- /dev/null
+++ b/internal/mail/modified_utf7.go
@@ -0,0 +1,63 @@
+package mail
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"strings"
+	"unicode/utf16"
+)
+
+// DecodeModifiedUTF7 decodes an IMAP mailbox name from Modified UTF-7.
+// Malformed encoded sections are preserved verbatim so the server-provided
+// name can still be shown and used as a mailbox identifier.
+func DecodeModifiedUTF7(value string) string {
+	var decoded strings.Builder
+	for i := 0; i < len(value); {
+		if value[i] != '&' {
+			decoded.WriteByte(value[i])
+			i++
+			continue
+		}
+
+		shiftLength := strings.IndexByte(value[i:], '-')
+		if shiftLength < 0 {
+			decoded.WriteByte(value[i])
+			i++
+			continue
+		}
+
+		end := i + shiftLength
+		if end == i+1 {
+			decoded.WriteByte('&')
+			i = end + 1
+			continue
+		}
+
+		encoded := strings.ReplaceAll(value[i+1:end], ",", "/")
+		if remainder := len(encoded) % 4; remainder != 0 {
+			encoded += strings.Repeat("=", 4-remainder)
+		}
+		bytes, err := base64.StdEncoding.DecodeString(encoded)
+		if err != nil || len(bytes)%2 != 0 {
+			decoded.WriteString(value[i : end+1])
+			i = end + 1
+			continue
+		}
+
+		units := make([]uint16, len(bytes)/2)
+		for j := range units {
+			units[j] = binary.BigEndian.Uint16(bytes[j*2 : j*2+2])
+		}
+		decoded.WriteString(string(utf16.Decode(units)))
+		i = end + 1
+	}
+	return decoded.String()
+}
+
+// DisplayMailboxName converts the protocol form to a readable label.
+func DisplayMailboxName(name string) string {
+	if strings.EqualFold(name, "INBOX") {
+		return "Входящие"
+	}
+	return DecodeModifiedUTF7(name)
+}
diff --git a/internal/mail/modified_utf7_test.go b/internal/mail/modified_utf7_test.go
new file mode 100644
index 0000000..24c7ca9
--- /dev/null
+++ b/internal/mail/modified_utf7_test.go
@@ -0,0 +1,30 @@
+package mail
+
+import "testing"
+
+func TestDecodeModifiedUTF7(t *testing.T) {
+	tests := []struct {
+		name string
+		want string
+	}{
+		{name: "INBOX", want: "INBOX"},
+		{name: "&-", want: "&"},
+		{name: "&BB4EQgQ,BEAEMAQyBDsENQQ9BD0ESwQ1-", want: "Отправленные"},
+		{name: "Archive/&BB4EQgQ,BEAEMAQyBDsENQQ9BD0ESwQ1-", want: "Archive/Отправленные"},
+		{name: "Malformed &BB4EQgQ-", want: "Malformed &BB4EQgQ-"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := DecodeModifiedUTF7(test.name); got != test.want {
+				t.Fatalf("DecodeModifiedUTF7(%q) = %q, want %q", test.name, got, test.want)
+			}
+		})
+	}
+}
+
+func TestDisplayMailboxName(t *testing.T) {
+	if got := DisplayMailboxName("INBOX"); got != "Входящие" {
+		t.Fatalf("DisplayMailboxName(INBOX) = %q, want Входящие", got)
+	}
+}
